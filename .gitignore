# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/tmp/
/.reference-react/
/.runlogs/

# Project-local .NET SDK and ASP.NET build artifacts
/.dotnet/
**/bin/
**/obj/
**/TestResults/
*.user
.vs/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local machine configuration
.vscode/settings.json

# Local environment files and signing credentials
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
/android/key.properties

# Backend credentials must never be stored in the Flutter client repository
*service-account*.json

# Local generated exports, browser profiles and publication assets
/output/
/LifeGuard_Thesis_Handover.pdf
/thesis/*.docx
/thesis/*.zip
/thesis/screenshots/
/thesis/*HANDOVER*.md
/docs/UPDATE_HANDOVER_*.md
/docs/TECHNICAL_HANDOVER.md
/thesis/CHAPTER_5_EVIDENCE_SUPPLEMENT.md
/thesis/THESIS_REVISION_GUIDE_*.md

# Preserve dated verification transcripts as repository evidence
!/thesis/verification-*.log
